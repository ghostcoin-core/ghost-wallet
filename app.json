{
  "expo": {
    "name": "Ghost Wallet",
    "slug": "ghost-wallet",
    "scheme": "ghostwallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "platforms": ["ios"],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ghostcoin.wallet",
      "appleTeamId": "U388328MWX",
      "supportsTablet": false,
      "infoPlist": {
        "NFCReaderUsageDescription": "Ghost Wallet uses NFC to write a Phantom Key to your NTAG 424 card, read it back to Summon or Claim, and wipe the card.",
        "com.apple.developer.nfc.readersession.iso7816.select-identifiers": ["D2760000850101"]
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": ["TAG"]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ghost Wallet uses Face ID to unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
