{
  "expo": {
    "name": "Ghost Wallet",
    "slug": "ghost-wallet",
    "scheme": "ghostwallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "platforms": ["ios"],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ghostcoin.wallet",
      "appleTeamId": "U388328MWX",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ghost Wallet uses Face ID to unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
