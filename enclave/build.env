# The pinned settings of the enclave program's build. enclave/Dockerfile and
# enclave/scripts/check-reproducible.sh both read this file, so the image and
# the reproducibility check build the same way. One KEY=value per line, no
# spaces, no quotes.
#
# The enclave's own region is not set here: it differs per image. Each
# region's image is built with SEAL_REGION=<region> (the Dockerfile's build
# argument), one per region of enclave/deploy/regions.json; compute-pcrs.sh
# and check-reproducible.sh build every region.
SEAL_TOOLCHAIN=1.99.1
SEAL_TARGET=aarch64-unknown-linux-gnu
SEAL_SOURCE_DATE_EPOCH=1793491200
SEAL_TARGET_FEATURES=+crt-static
SEAL_BUILD_ROOT=/seal-build
SEAL_CARGO_ROOT=/cargo
# The host's proxy (not measured): musl, so its name lookups work on any host.
SEAL_PROXY_TARGET=aarch64-unknown-linux-musl
